name: macOS CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: macos-14
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - name: Install XcodeGen
        run: brew install xcodegen
      - name: Generate Xcode project
        run: xcodegen generate
      - name: Run unit tests
        run: |
          xcodebuild \
            -project HapiCompanion.xcodeproj \
            -scheme HapiCompanion \
            -destination 'platform=macOS' \
            -derivedDataPath .build \
            CODE_SIGNING_ALLOWED=NO test
      - name: Verify Hub patch shape
        run: |
          test -s integrations/hapi/hapi-companion.patch
          grep -q 'companionNotificationStore.ts' integrations/hapi/hapi-companion.patch
          grep -q 'hub/src/web/routes/companion.ts' integrations/hapi/hapi-companion.patch
