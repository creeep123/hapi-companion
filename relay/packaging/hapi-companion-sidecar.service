[Unit]
Description=HAPI Companion Official API Sidecar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hapi-mobile-relay
Group=hapi-mobile-relay
ExecStart=/opt/hapi-companion-sidecar/current/hapi-mobile-relay serve-sidecar
EnvironmentFile=/etc/hapi-companion-sidecar/environment
LoadCredential=hapi-access-token:/etc/hapi-companion-sidecar/hapi-access-token
Environment=HAPI_MOBILE_RELAY_STATE=/var/lib/hapi-companion-sidecar/state.json
Environment=HAPI_SIDECAR_DB=/var/lib/hapi-companion-sidecar/sidecar.sqlite
Environment=HAPI_MOBILE_RELAY_HOST=127.0.0.1
Environment=HAPI_MOBILE_RELAY_PORT=8790
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/hapi-companion-sidecar
UMask=0077

[Install]
WantedBy=multi-user.target
