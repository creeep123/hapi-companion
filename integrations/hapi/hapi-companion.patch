+async function readEventIds(response: Response, count: number): Promise<{ ids: number[]; text: string; reader: { cancel(): Promise<void> } }> {
+    const reader = response.body!.getReader()
+    const ids: number[] = []
+    let buffered = ''
+    while (ids.length < count) {
+        const next = await reader.read()
+        if (next.done) break
+        buffered += new TextDecoder().decode(next.value)
+        const matches = [...buffered.matchAll(/^id: (\d+)$/gm)]
+        ids.splice(0, ids.length, ...matches.map((match) => Number(match[1])))
+    }
+    return { ids, text: buffered, reader }
+}
