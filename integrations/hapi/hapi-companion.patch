+import { describe, expect, it } from 'bun:test'
+import { Store } from './index'
+
+describe('CompanionNotificationStore', () => {
+    it('registers and authenticates a device without storing the plaintext token', () => {
+        const store = new Store(':memory:')
+        const registration = store.companionNotifications.registerDevice('default', 'MacAir', '11111111-1111-4111-8111-111111111111')
+
+        expect(registration.device.id).toMatch(/^[0-9a-f-]{36}$/)
+        expect(store.companionNotifications.authenticate(registration.device.id, registration.token)?.namespace).toBe('default')
+        expect(store.companionNotifications.authenticate(registration.device.id, 'wrong')).toBeNull()
+        store.close()
+    })
+
+    it('persists ordered notifications and advances acknowledgements monotonically', () => {
+        const store = new Store(':memory:')
+        const { device, token } = store.companionNotifications.registerDevice('default', 'MacAir', '11111111-1111-4111-8111-111111111111')
+        const base = {
+            version: 1 as const,
+            kind: 'session-completed' as const,
+            title: 'Done',
+            body: 'Finished',
+            severity: 'success' as const,
+            sessionId: 'session-1',
+            sessionName: 'Test',
+            url: '/sessions/session-1'
+        }
+        const first = store.companionNotifications.append('default', base)
+        const second = store.companionNotifications.append('default', base)
+
+        expect(store.companionNotifications.listAfter('default', first.seq)).toEqual([second])
+        expect(store.companionNotifications.acknowledge('default', device.id, second.seq, second.payload.eventId)).toBe(true)
+        expect(store.companionNotifications.acknowledge('default', device.id, first.seq, first.payload.eventId)).toBe(true)
+        expect(store.companionNotifications.authenticate(device.id, token)?.lastAckSeq).toBe(second.seq)
+        store.close()
+    })
+
+    it('keeps namespaces isolated', () => {
+        const store = new Store(':memory:')
+        store.companionNotifications.append('alpha', {
+            version: 1,
+            kind: 'ready',
+            title: 'Ready',
+            body: 'Alpha',
+            severity: 'info',
+            sessionId: 's1',
+            sessionName: 'Alpha',
+            url: '/sessions/s1'
+        })
+        expect(store.companionNotifications.listAfter('beta', 0)).toEqual([])
+        store.close()
+    })
+
+    it('starts a newly registered installation at the current namespace high-water mark', () => {
+        const store = new Store(':memory:')
+        const old = store.companionNotifications.append('default', {
+            version: 1, kind: 'ready', title: 'Old', body: 'Old', severity: 'info',
+            sessionId: 's1', sessionName: 'Old', url: '/sessions/s1'
+        })
+        const registration = store.companionNotifications.registerDevice(
+            'default', 'MacAir', '11111111-1111-4111-8111-111111111111'
+        )
+        expect(registration.device.lastAckSeq).toBe(old.seq)
+        store.close()
+    })
+
+    it('never rebinds the same installation identifier across namespaces', () => {
+        const store = new Store(':memory:')
+        const installation = '11111111-1111-4111-8111-111111111111'
+        const alpha = store.companionNotifications.registerDevice('alpha', 'MacAir', installation)
+        const beta = store.companionNotifications.registerDevice('beta', 'MacAir', installation)
+        expect(alpha.device.id).not.toBe(beta.device.id)
+        expect(store.companionNotifications.authenticate(alpha.device.id, alpha.token)?.namespace).toBe('alpha')
+        expect(store.companionNotifications.authenticate(beta.device.id, beta.token)?.namespace).toBe('beta')
+        store.close()
+    })
+
+    it('paginates a backlog larger than the per-query cap', () => {
+        const store = new Store(':memory:')
+        const base = {
+            version: 1 as const, kind: 'ready' as const, title: 'Ready', body: 'Body', severity: 'info' as const,
+            sessionId: 's1', sessionName: 'Test', url: '/sessions/s1'
+        }
+        for (let i = 0; i < 501; i += 1) store.companionNotifications.append('default', base)
+        const watermark = store.companionNotifications.latestSeq('default')
+        const first = store.companionNotifications.listRange('default', 0, watermark, 500)
+        const second = store.companionNotifications.listRange('default', first.at(-1)!.seq, watermark, 500)
+        expect(first).toHaveLength(500)
+        expect(second).toHaveLength(1)
+        store.close()
+    })
+})
