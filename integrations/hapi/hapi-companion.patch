+import { describe, expect, it } from 'bun:test'
+import type { Session } from '../sync/syncEngine'
+import { TurnDurationTracker } from './turnDurationTracker'
+
+function state(thinking: boolean, activeTurnStartedAt?: number | null): Session {
+    return { id: 'one', thinking, activeTurnStartedAt } as Session
+}
+
+describe('turn duration evidence', () => {
+    it('freezes completion and retains it across heartbeat/end ordering', () => {
+        const tracker = new TurnDurationTracker()
+        tracker.observe(state(true, 1000), 1000)
+        tracker.observe(state(true, 1000), 2000)
+        expect(tracker.complete('one', 5000)).toBe(4000)
+        tracker.observe(state(false, null), 6000)
+        expect(tracker.complete('one', 9000)).toBe(4000)
+    })
+    it('captures heartbeat-ended duration before a later completion', () => {
+        const tracker = new TurnDurationTracker()
+        tracker.observe(state(true, 1000), 1000)
+        tracker.observe(state(false, null), 2000)
+        expect(tracker.complete('one', 9000)).toBe(1000)
+    })
+    it('starts a fresh identity even while thinking remains true', () => {
+        const tracker = new TurnDurationTracker()
+        tracker.observe(state(true, 1000), 1000)
+        expect(tracker.complete('one', 9000)).toBe(8000)
+        tracker.observe(state(true, 10000), 10000)
+        expect(tracker.complete('one', 11000)).toBe(1000)
+        tracker.observe(state(false), 12000)
+        tracker.observe(state(true, 13000), 13000)
+        expect(tracker.complete('one', 14000)).toBe(1000)
+    })
+    it('never invents a start from heartbeat, conversation age, restart or malformed time', () => {
+        for (const start of [undefined, null, NaN, Infinity, -1, 50000]) {
+            const tracker = new TurnDurationTracker()
+            tracker.observe(state(true, start), 1000)
+            tracker.observe(state(false), 2000)
+            expect(tracker.complete('one', 3000)).toBeUndefined()
+        }
+        const tracker = new TurnDurationTracker()
+        tracker.observe(state(true, 1000), 1000)
+        tracker.remove('one')
+        expect(tracker.complete('one', 2000)).toBeUndefined()
+        tracker.observe(state(true, 1000), 1000)
+        tracker.clear()
+        expect(tracker.complete('one', 2000)).toBeUndefined()
+    })
+})
diff --git a/hub/src/notifications/turnDurationTracker.ts b/hub/src/notifications/turnDurationTracker.ts
new file mode 100644
index 00000000..b6d36035
--- /dev/null
+++ b/hub/src/notifications/turnDurationTracker.ts
@@ -0,0 +1,43 @@
+import type { Session } from '../sync/syncEngine'
+
+type Turn = { thinking: boolean; start?: number; duration?: number }
+
+/** In-memory evidence only: unknown starts after reconnect/restart stay unknown. */
+export class TurnDurationTracker {
+    private readonly turns = new Map<string, Turn>()
+
+    observe(session: Session, now = Date.now()): void {
+        const old = this.turns.get(session.id)
+        const candidate = session.activeTurnStartedAt
+        const start = typeof candidate === 'number' && Number.isSafeInteger(candidate)
+            && candidate >= 0 && candidate <= now ? candidate : undefined
+        if (session.thinking) {
+            if (!old?.thinking || (start !== undefined && start !== old.start)) {
+                this.turns.set(session.id, { thinking: true, start })
+            }
+        } else if (old?.thinking) {
+            this.turns.set(session.id, {
+                thinking: false, start: old.start,
+                duration: old.duration ?? this.elapsed(old.start, now)
+            })
+        } else if (!old) {
+            this.turns.set(session.id, { thinking: false })
+        }
+    }
+
+    /** Completion freezes the turn before asynchronous channel fan-out. */
+    complete(sessionId: string, now = Date.now()): number | undefined {
+        const turn = this.turns.get(sessionId)
+        if (!turn) return undefined
+        turn.duration ??= this.elapsed(turn.start, now)
+        return turn.duration
+    }
+
+    private elapsed(start: number | undefined, now: number): number | undefined {
+        const duration = start === undefined ? NaN : now - start
+        return Number.isSafeInteger(duration) && duration >= 0 ? duration : undefined
+    }
+
+    remove(sessionId: string): void { this.turns.delete(sessionId) }
+    clear(): void { this.turns.clear() }
+}
