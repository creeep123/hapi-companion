@@ -0,0 +1,31 @@
+import type { Store, StoredCompanionNotification, CompanionNotificationPayload } from '../store'
+
+type Listener = (notification: StoredCompanionNotification) => void
+
+export class CompanionNotificationBroker {
+    private readonly listeners = new Set<Listener>()
+    private lastPruneAt = 0
+
+    constructor(private readonly store: Store) {}
+
+    publish(namespace: string, payload: Omit<CompanionNotificationPayload, 'eventId' | 'createdAt'>): StoredCompanionNotification {
+        const now = Date.now()
+        if (now - this.lastPruneAt >= 60 * 60 * 1000) {
+            this.store.companionNotifications.prune(now)
+            this.lastPruneAt = now
+        }
+        const notification = this.store.companionNotifications.append(namespace, payload)
+        for (const listener of this.listeners) listener(notification)
+        return notification
+    }
+
+    subscribe(listener: Listener): () => void {
+        this.listeners.add(listener)
+        return () => this.listeners.delete(listener)
+    }
+
+    /** Observable for connection-lifecycle tests; no listener data is exposed. */
+    get listenerCount(): number {
+        return this.listeners.size
+    }
+}
