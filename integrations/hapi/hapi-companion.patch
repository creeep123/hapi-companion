+++ b/hub/src/web/routes/companion.ts
@@ -0,0 +1,164 @@
+import type { Session } from '../../sync/syncEngine'
+import { getSessionName } from '../../notifications/sessionInfo'
+import { Hono } from 'hono'
+import { streamSSE } from 'hono/streaming'
+import { z } from 'zod'
+import type { Store, StoredCompanionNotification } from '../../store'
+import type { CompanionNotificationBroker } from '../../notifications/companionNotificationBroker'
+import type { WebAppEnv } from '../middleware/auth'
+
+const registrationSchema = z.object({
+    installationId: z.string().uuid(),
+    name: z.string().min(1).max(128)
+})
+
+const ackSchema = z.object({ seq: z.number().int().nonnegative(), eventId: z.string().uuid() })
+
+export function createCompanionRegistrationRoutes(store: Store): Hono<WebAppEnv> {
+    const app = new Hono<WebAppEnv>()
+    app.post('/companion/devices/register', async (c) => {
+        const parsed = registrationSchema.safeParse(await c.req.json().catch(() => null))
+        if (!parsed.success) return c.json({ error: 'Invalid body' }, 400)
+        const registration = store.companionNotifications.registerDevice(
+            c.get('namespace'),
+            parsed.data.name,
+            parsed.data.installationId
+        )
+        return c.json({
+            deviceId: registration.device.id,
+            token: registration.token,
+            lastAckSeq: registration.device.lastAckSeq
+        })
+    })
+    app.delete('/companion/devices/:deviceId', (c) => {
+        const ok = store.companionNotifications.disableDevice(c.get('namespace'), c.req.param('deviceId'))
+        return ok ? c.json({ ok: true }) : c.json({ error: 'Device not found' }, 404)
+    })
+    return app
+}
+
+export function createCompanionDeviceRoutes(
+    store: Store,
+    broker: CompanionNotificationBroker,
+    getSessions?: (namespace: string) => Session[] | undefined
+): Hono {
+    const app = new Hono()
+
+    const authenticate = (authorization: string | undefined, deviceId: string | undefined) => {
+        const token = authorization?.startsWith('Bearer ') ? authorization.slice(7) : null
+        if (!token || !deviceId) return null
+        return store.companionNotifications.authenticate(deviceId, token)
+    }
+
+    app.get('/sessions', (c) => {
+        const device = authenticate(c.req.header('authorization'), c.req.header('x-hapi-device-id'))
+        if (!device) return c.json({ error: 'Invalid companion credentials' }, 401)
+        const sessions = getSessions?.(device.namespace)
+        if (!sessions) return c.json({ error: 'Session catalog unavailable' }, 503)
+        return c.json({
+            capabilities: { turnDuration: true },
+            sessions: sessions.filter((session) => session.namespace === device.namespace).map((session) => ({
+                id: session.id,
+                title: getSessionName(session),
+                ...(session.metadata?.host ? { machineName: session.metadata.host } : {}),
+                updatedAt: session.updatedAt,
+                active: session.active
+            }))
+        })
+    })
+
+    app.get('/events', (c) => {
+        const device = authenticate(c.req.header('authorization'), c.req.header('x-hapi-device-id'))
+        if (!device) return c.json({ error: 'Invalid companion credentials' }, 401)
+        return streamSSE(c, async (stream) => {
+            const queue: StoredCompanionNotification[] = []
+            let wake: (() => void) | undefined
+            let overflow = false
+            let aborted = c.req.raw.signal.aborted
+            const enqueue = (item: StoredCompanionNotification) => {
+                if (item.namespace !== device.namespace) return
+                if (queue.length >= 1024) {
+                    overflow = true
+                    wake?.()
+                    return
+                }
+                queue.push(item)
+                wake?.()
+            }
+            const unsubscribe = broker.subscribe(enqueue)
+            const abort = () => {
+                aborted = true
+                wake?.()
+            }
+            c.req.raw.signal.addEventListener('abort', abort)
+            stream.onAbort(abort)
+            const write = async (item: StoredCompanionNotification) => {
+                await stream.writeSSE({
+                    id: String(item.seq),
+                    event: 'notification',
+                    data: JSON.stringify(item.payload)
+                })
+            }
+            try {
+                // Flush response headers immediately. This prevents URLSession and
+                // edge proxies from waiting for the first real notification.
+                await stream.writeSSE({ event: 'connected', data: '{}' })
+                // ACK is the only durable delivery cursor. Last-Event-ID is deliberately ignored.
+                const watermark = store.companionNotifications.latestSeq(device.namespace)
+                let replayCursor = device.lastAckSeq
+                while (replayCursor < watermark) {
+                    const page = store.companionNotifications.listRange(device.namespace, replayCursor, watermark, 500)
+                    if (page.length === 0) break
+                    for (const item of page) await write(item)
+                    replayCursor = page.at(-1)!.seq
+                }
+
+                let lastWritten = replayCursor
+                while (!aborted) {
+                    if (overflow) throw new Error('Companion live queue overflow')
+                    queue.sort((a, b) => a.seq - b.seq)
+                    const item = queue.shift()
+                    if (item) {
+                        if (item.seq > lastWritten) {
+                            await write(item)
+                            lastWritten = item.seq
+                        }
+                        continue
+                    }
+                    await new Promise<void>((resolve) => {
+                        const timer = setTimeout(() => {
+                            wake = undefined
+                            resolve()
+                        }, 30_000)
+                        wake = () => {
+                            clearTimeout(timer)
+                            resolve()
+                        }
+                    })
+                    wake = undefined
+                    if (queue.length === 0 && !aborted) {
+                        await stream.writeSSE({ event: 'heartbeat', data: '{}' })
+                    }
+                }
+            } finally {
+                unsubscribe()
+                c.req.raw.signal.removeEventListener('abort', abort)
+                wake?.()
+            }
+        })
+    })
+
+    app.post('/ack', async (c) => {
+        const device = authenticate(c.req.header('authorization'), c.req.header('x-hapi-device-id'))
+        if (!device) return c.json({ error: 'Invalid companion credentials' }, 401)
+        const parsed = ackSchema.safeParse(await c.req.json().catch(() => null))
+        if (!parsed.success) return c.json({ error: 'Invalid body' }, 400)
+        const acknowledged = store.companionNotifications.acknowledge(
+            device.namespace, device.id, parsed.data.seq, parsed.data.eventId
+        )
+        if (!acknowledged) return c.json({ error: 'Invalid acknowledgement cursor' }, 409)
+        return c.json({ ok: true })
+    })
+
+    return app
+}
