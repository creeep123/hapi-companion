@@ -0,0 +1,47 @@
+import type { NotificationSendContext } from './notificationSendContext'
+import type { Session } from '../sync/syncEngine'
+import type { SessionEndReason } from '@hapi/protocol'
+import type { NotificationChannel, TaskNotification } from './notificationTypes'
+import { NativeNotificationComposer } from './nativeNotificationComposer'
+import type { CompanionNotificationBroker } from './companionNotificationBroker'
+
+export class CompanionNotificationChannel implements NotificationChannel {
+    constructor(
+        private readonly broker: CompanionNotificationBroker,
+        private readonly composer: NativeNotificationComposer
+    ) {}
+
+    async sendReady(session: Session, ctx?: NotificationSendContext): Promise<void> {
+        this.publish(session, this.composer.composeReady(session), ctx)
+    }
+
+    async sendPermissionRequest(session: Session): Promise<void> {
+        this.publish(session, this.composer.composePermissionRequest(session))
+    }
+
+    async sendTaskNotification(session: Session, notification: TaskNotification): Promise<void> {
+        this.publish(session, this.composer.composeTask(session, notification))
+    }
+
+    async sendSessionCompletion(session: Session, reason: SessionEndReason, ctx?: NotificationSendContext): Promise<void> {
+        this.publish(session, this.composer.composeSessionCompletion(session, reason), ctx)
+    }
+
+    private publish(session: Session, composed: ReturnType<NativeNotificationComposer['composeReady']>, ctx?: NotificationSendContext): void {
+        this.broker.publish(session.namespace, {
+            version: 1,
+            ...(ctx?.durationMs !== undefined && Number.isSafeInteger(ctx.durationMs) && ctx.durationMs >= 0
+                ? { durationMs: ctx.durationMs } : {}),
+            kind: composed.type,
+            title: composed.title,
+            body: composed.body,
+            severity: composed.severity,
+            sessionId: composed.sessionId,
+            sessionName: composed.sessionName,
+            ...(session.metadata?.machineId ? { machineId: session.metadata.machineId } : {}),
+            url: composed.url,
+            ...(composed.requestId ? { requestId: composed.requestId } : {}),
+            ...(composed.tag ? { tag: composed.tag } : {})
+        })
+    }
+}
