new file mode 100644
index 00000000..99b39977
--- /dev/null
+++ b/hub/src/store/companionNotificationStore.ts
@@ -0,0 +1,164 @@
+import type { Database } from 'bun:sqlite'
+import { createHash, randomBytes, randomUUID, timingSafeEqual } from 'node:crypto'
+import type {
+    CompanionNotificationPayload,
+    StoredCompanionDevice,
+    StoredCompanionNotification
+} from './types'
+
+type DeviceRow = {
+    id: string
+    installation_id: string
+    namespace: string
+    name: string
+    token_hash: string
+    created_at: number
+    updated_at: number
+    last_ack_seq: number
+    enabled: number
+}
+
+type NotificationRow = {
+    seq: number
+    namespace: string
+    payload_json: string
+    created_at: number
+    expires_at: number
+}
+
+export class CompanionNotificationStore {
+    constructor(private readonly db: Database) {}
+
+    registerDevice(namespace: string, name: string, installationId: string): { device: StoredCompanionDevice; token: string } {
+        const deviceId = randomUUID()
+        const token = randomBytes(32).toString('base64url')
+        const now = Date.now()
+        const initialAck = this.latestSeq(namespace)
+        this.db.prepare(`
+            INSERT INTO companion_devices (
+                id, installation_id, namespace, name, token_hash, created_at, updated_at, last_ack_seq, enabled
+            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, 1)
+            ON CONFLICT(namespace, installation_id) DO UPDATE SET
+                name = excluded.name,
+                token_hash = excluded.token_hash,
+                updated_at = excluded.updated_at,
+                enabled = 1
+            RETURNING id
+        `).get(deviceId, installationId, namespace, name, this.hashToken(token), now, now, initialAck) as { id: string }
+        const row = this.db.prepare(
+            'SELECT * FROM companion_devices WHERE namespace = ? AND installation_id = ?'
+        ).get(namespace, installationId) as DeviceRow
+        return { device: this.toDevice(row), token }
+    }
+
+    authenticate(deviceId: string, token: string): StoredCompanionDevice | null {
+        const row = this.db.prepare(
+            'SELECT * FROM companion_devices WHERE id = ? AND enabled = 1'
+        ).get(deviceId) as DeviceRow | null
+        if (!row) return null
+        const actual = Buffer.from(row.token_hash, 'hex')
+        const candidate = Buffer.from(this.hashToken(token), 'hex')
+        if (actual.length !== candidate.length || !timingSafeEqual(actual, candidate)) return null
+        return this.toDevice(row)
+    }
+
+    disableDevice(namespace: string, deviceId: string): boolean {
+        return this.db.prepare(
+            'UPDATE companion_devices SET enabled = 0, updated_at = ? WHERE namespace = ? AND id = ?'
+        ).run(Date.now(), namespace, deviceId).changes > 0
+    }
+
+    append(namespace: string, payload: Omit<CompanionNotificationPayload, 'eventId' | 'createdAt'>): StoredCompanionNotification {
+        const createdAt = Date.now()
+        const full: CompanionNotificationPayload = {
+            ...payload,
+            eventId: randomUUID(),
+            createdAt
+        }
+        const expiresAt = createdAt + 7 * 24 * 60 * 60 * 1000
+        const result = this.db.prepare(`
+            INSERT INTO companion_notification_outbox (
+                event_id, namespace, payload_json, created_at, expires_at
+            ) VALUES (?, ?, ?, ?, ?)
+        `).run(full.eventId, namespace, JSON.stringify(full), createdAt, expiresAt)
+        return {
+            seq: Number(result.lastInsertRowid),
+            namespace,
+            payload: full,
+            createdAt,
+            expiresAt
+        }
+    }
+
+    latestSeq(namespace: string): number {
+        const row = this.db.prepare(
+            'SELECT COALESCE(MAX(seq), 0) AS seq FROM companion_notification_outbox WHERE namespace = ?'
+        ).get(namespace) as { seq: number }
+        return row.seq
+    }
+
+    listRange(namespace: string, afterSeq: number, throughSeq: number, limit = 100): StoredCompanionNotification[] {
+        const boundedLimit = Math.max(1, Math.min(limit, 500))
+        const rows = this.db.prepare(`
+            SELECT seq, namespace, payload_json, created_at, expires_at
+            FROM companion_notification_outbox
+            WHERE namespace = ? AND seq > ? AND seq <= ? AND expires_at > ?
+            ORDER BY seq ASC
+            LIMIT ?
+        `).all(namespace, afterSeq, throughSeq, Date.now(), boundedLimit) as NotificationRow[]
+        return rows.map((row) => ({
+            seq: row.seq,
+            namespace: row.namespace,
+            payload: JSON.parse(row.payload_json) as CompanionNotificationPayload,
+            createdAt: row.created_at,
+            expiresAt: row.expires_at
+        }))
+    }
+
+    listAfter(namespace: string, afterSeq: number, limit = 100): StoredCompanionNotification[] {
+        return this.listRange(namespace, afterSeq, Number.MAX_SAFE_INTEGER, limit)
+    }
+
+    acknowledge(namespace: string, deviceId: string, seq: number, eventId: string): boolean {
+        return this.db.prepare(`
+            UPDATE companion_devices
+            SET last_ack_seq = MAX(last_ack_seq, ?), updated_at = ?
+            WHERE namespace = ? AND id = ? AND enabled = 1
+              AND EXISTS (
+                  SELECT 1
+                  FROM companion_notification_outbox AS outbox
+                  WHERE outbox.namespace = ? AND outbox.seq = ? AND outbox.event_id = ?
+              )
+        `).run(seq, Date.now(), namespace, deviceId, namespace, seq, eventId).changes > 0
+    }
+
+    prune(now = Date.now()): number {
+        return this.db.prepare(
+            'DELETE FROM companion_notification_outbox WHERE expires_at <= ?'
+        ).run(now).changes
+    }
+
+    private getDevice(namespace: string, deviceId: string): StoredCompanionDevice | null {
+        const row = this.db.prepare(
+            'SELECT * FROM companion_devices WHERE namespace = ? AND id = ?'
+        ).get(namespace, deviceId) as DeviceRow | null
+        return row ? this.toDevice(row) : null
+    }
+
+    private toDevice(row: DeviceRow): StoredCompanionDevice {
+        return {
+            id: row.id,
+            installationId: row.installation_id,
+            namespace: row.namespace,
+            name: row.name,
+            createdAt: row.created_at,
+            updatedAt: row.updated_at,
+            lastAckSeq: row.last_ack_seq,
+            enabled: row.enabled === 1
+        }
+    }
+
+    private hashToken(token: string): string {
+        return createHash('sha256').update(token).digest('hex')
+    }
+}
