diff --git a/hub/src/store/migration-v25.test.ts b/hub/src/store/migration-v25.test.ts
new file mode 100644
index 00000000..6e9e4fcf
--- /dev/null
+++ b/hub/src/store/migration-v25.test.ts
@@ -0,0 +1,45 @@
+import { afterEach, describe, expect, it } from 'bun:test'
+import { Database } from 'bun:sqlite'
+import { mkdtempSync, rmSync } from 'node:fs'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { Store } from './index'
+
+const dirs: string[] = []
+afterEach(() => {
+    for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true })
+})
+
+describe('schema migration v25 to v26', () => {
+    it('adds durable companion device and notification tables', () => {
+        const dir = mkdtempSync(join(tmpdir(), 'hapi-migration-v25-'))
+        dirs.push(dir)
+        const path = join(dir, 'hapi.db')
+        const initial = new Store(path)
+        initial.close()
+
+        const legacy = new Database(path)
+        legacy.exec(`
+            DROP TABLE companion_notification_outbox;
+            DROP TABLE companion_devices;
+            PRAGMA user_version = 25;
+        `)
+        legacy.close()
+
+        const migrated = new Store(path)
+        const internal = new Database(path, { readonly: true })
+        const version = internal.prepare('PRAGMA user_version').get() as { user_version: number }
+        const tables = internal.prepare(`
+            SELECT name FROM sqlite_master
+            WHERE type = 'table' AND name LIKE 'companion_%'
+            ORDER BY name
+        `).all() as Array<{ name: string }>
+        expect(version.user_version).toBe(26)
+        expect(tables.map((row) => row.name)).toEqual([
+            'companion_devices',
+            'companion_notification_outbox'
+        ])
+        internal.close()
+        migrated.close()
+    })
+})
